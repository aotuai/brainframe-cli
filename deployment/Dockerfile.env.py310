ARG UBUNTU_VERSION=22.04
ARG POETRY_VERSION=1.8.3
ARG PYPROJECT
ARG POETRYLOCK
ARG WORKDIR

FROM ubuntu:${UBUNTU_VERSION}

ARG POETRY_VERSION
ARG PYPROJECT
ARG POETRYLOCK
ARG WORKDIR

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:$PATH"

# Install Python 3.10 natively, along with build tools and dh-virtualenv
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        python3-dev \
        dpkg-dev \
        devscripts \
        equivs \
        dh-virtualenv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install Poetry
RUN pip install --upgrade pip setuptools wheel
RUN pip install poetry==${POETRY_VERSION}

WORKDIR $WORKDIR

# Copy the specific pyproject and lock files injected by ide_cli
COPY ./deployment/${PYPROJECT} ./pyproject.toml
COPY ./deployment/${POETRYLOCK} ./poetry.lock

# Install project dependencies
RUN poetry lock --no-update
RUN poetry install --no-interaction --no-ansi --no-root --with dev

# Create symlink for python
RUN ln -sf /usr/bin/python3 /usr/bin/python